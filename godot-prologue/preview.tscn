[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://preview.gd" id="1"]

[node name="ProloguePreview" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 6
script = ExtResource("1")

[node name="Layout" type="VBoxContainer" parent="."]
theme_override_constants/separation = 4

[node name="Scroll" type="ScrollContainer" parent="Layout"]
unique_name_in_owner = true
size_flags_vertical = 3
vertical_scroll_mode = 0

[node name="Canvas" type="Control" parent="Layout/Scroll"]
unique_name_in_owner = true
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 2

[node name="Caption" type="HBoxContainer" parent="Layout"]
theme_override_constants/separation = 14

[node name="Picker" type="OptionButton" parent="Layout/Caption"]
unique_name_in_owner = true
focus_mode = 0
tooltip_text = "选择序章场景，或按 ← / → 换图"
flat = true
fit_to_longest_item = false
theme_override_colors/font_color = Color(0.93, 0.86, 0.75, 1)

[node name="Space" type="Control" parent="Layout/Caption"]
size_flags_horizontal = 3
mouse_filter = 2

[node name="Status" type="Label" parent="Layout/Caption"]
unique_name_in_owner = true
theme_override_colors/font_color = Color(0.69, 0.65, 0.61, 1)
theme_override_font_sizes/font_size = 14

[node name="Fit" type="Button" parent="Layout/Caption"]
unique_name_in_owner = true
visible = false
focus_mode = 0
tooltip_text = "展开后可拖动滚动条查看长卷"
toggle_mode = true
button_pressed = true
flat = true
text = "展开长卷"

[node name="Layer" type="Button" parent="Layout/Caption"]
unique_name_in_owner = true
focus_mode = 0
tooltip_text = "切换表层与里层（Tab）"
toggle_mode = true
flat = true
text = "表层 · 浓墨"

[node name="Play" type="Button" parent="Layout/Caption"]
unique_name_in_owner = true
focus_mode = 0
flat = true
text = "操控墨痕"

[node name="Sequence" type="Button" parent="Layout/Caption"]
unique_name_in_owner = true
focus_mode = 0
flat = true
tooltip_text = "从死牢绝壁连续播放到飞瀑洗血卷"
text = "连播"
